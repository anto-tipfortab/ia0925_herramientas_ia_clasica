# Copy this file to `.env` and fill in your own values.
# Do NOT commit real secrets. `.env` is gitignored.

# --- Google Cloud / Dialogflow ES ---
# The agent authenticates with Application Default Credentials (ADC):
#   gcloud auth application-default login
# so GOOGLE_APPLICATION_CREDENTIALS is NOT needed (leave it unset / commented).
# GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
#
# Project that HOSTS the Dialogflow ES agent (Dialogflow Console → Settings → Project ID).
GOOGLE_PROJECT_ID=your-dialogflow-project-id
# Same project, used as the ADC quota project (required for user-ADC; also silences a warning).
GOOGLE_CLOUD_PROJECT=your-dialogflow-project-id

# --- AWS (Polly TTS) ---
# Use a named profile from ~/.aws (recommended) OR static keys (AWS_ACCESS_KEY_ID/SECRET).
# The IAM identity needs polly:SynthesizeSpeech (managed policy AmazonPollyReadOnlyAccess).
AWS_PROFILE=default
AWS_DEFAULT_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# --- OpenAI (Whisper STT + embeddings + LLM for RAG) ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional ---
DIALOGFLOW_SESSION_ID=funstay-demo-session

# --- Endpoint hardening (all optional; secure defaults) ---
# Authenticate inbound requests. HMAC is preferred for /webhook (signs the raw
# body); the shared secret is used for /voice and as a fallback for /webhook.
# Configure Dialogflow's webhook to send the matching header.
# WEBHOOK_HMAC_SECRET=change-me-long-random
# WEBHOOK_SHARED_SECRET=change-me-long-random
# WEBHOOK_AUTH_HEADER=X-Funstay-Token
# WEBHOOK_SIGNATURE_HEADER=X-Funstay-Signature
# Fail closed: refuse to serve protected endpoints if no secret is configured.
# WEBHOOK_AUTH_REQUIRED=false
# Comma-separated CORS allowlist (empty = no cross-origin requests allowed).
# CORS_ALLOW_ORIGINS=https://app.example.com,https://demo.example.com
# Request body size ceilings (bytes).
# MAX_WEBHOOK_BYTES=262144
# MAX_VOICE_BYTES=10485760
# Outbound resilience: OpenAI timeout (s) + retries; Polly timeouts (s) + attempts.
# OPENAI_TIMEOUT=30
# OPENAI_MAX_RETRIES=3
# POLLY_CONNECT_TIMEOUT=5
# POLLY_READ_TIMEOUT=15
# POLLY_MAX_ATTEMPTS=3
